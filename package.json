{
  "name": "athena-screen-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8770",
    "build": "vite build",
    "build:hosted": "vite build --mode hosted && node scripts/package-hosted.mjs",
    "test": "node --test tests/*.test.js",
    "test:firmware": "node firmware/test.mjs",
    "test:pet": "node firmware/v2/test.mjs",
    "build:pet": "node scripts/build-scene.mjs && node scripts/build-pet.mjs",
    "test:typing": "node firmware/v2/typing-test.mjs"
  },
  "dependencies": {
    "gifuct-js": "2.1.2"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.8",
    "vite": "^7.2.2"
  },
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/kbdfans/athena-studio.git"
  }
}
